VITE_SUPABASE_URL=your-supabase-url
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Analitica de producto (PostHog) — OPCIONAL.
# Sin esta key, la analitica queda apagada (no-op, cero llamadas de red).
# 1. Crea cuenta gratis en https://posthog.com (free: 1M eventos/mes).
# 2. Copia tu Project API Key (empieza con "phc_").
# 3. Pegala aqui y tambien en Vercel (Settings > Environment Variables).
VITE_POSTHOG_KEY=phc_tu_project_api_key
# Solo si tu proyecto es region EU (por defecto US):
# VITE_POSTHOG_HOST=https://eu.i.posthog.com

# ─────────────────────────────────────────────────────────────
# Variables del SERVIDOR (Vercel Functions en /api).
# NO llevan prefijo VITE_ (no se exponen al navegador). Se configuran
# en Vercel > Settings > Environment Variables, no en el bundle.
# ─────────────────────────────────────────────────────────────

# Anthropic — usada por /api/agent, /api/guia y /api/generate-program
# (la Guia IA, el chat "Tu Ronda" y la generacion de programas).
ANTHROPIC_API_KEY=sk-ant-...

# ElevenLabs — voz de Tu Ronda (/api/speak).
# Sin esta key la app funciona igual, solo que sin audio: el boton "Escuchar"
# no se muestra. La key NUNCA llega al navegador.
# 1. Crea cuenta en https://elevenlabs.io y copia tu API key (Profile > API Keys).
# 2. Pegala en Vercel > Settings > Environment Variables.
ELEVENLABS_API_KEY=sk_...
# Opcional. Si no la defines, /api/speak toma la primera voz femenina de tu
# cuenta. Para fijar una: ElevenLabs > Voices > la voz > Copy voice ID.
# ELEVENLABS_VOICE_ID=
# Opcional. Por defecto eleven_multilingual_v2 (mejor calidad en espanol).
# Para menor latencia: eleven_flash_v2_5.
# ELEVENLABS_MODEL_ID=

# Supabase para el servidor — /api/agent, /api/guia, /api/generate-program y
# /api/speak solo responden a una usuaria con sesion y con Ronda+
# (api/_auth.js). Si no las defines, el servidor usa VITE_SUPABASE_URL y
# VITE_SUPABASE_ANON_KEY de arriba; sin ninguna de las dos, esos endpoints
# responden 401.
# SUPABASE_URL=your-supabase-url
# SUPABASE_ANON_KEY=your-supabase-anon-key

# OneSignal — las notificaciones push solo usan el App ID, que va en
# src/lib/useOneSignal.js. No hace falta ninguna llave de OneSignal en el
# servidor: NO pongas la REST API key en Vercel (puede mandar notificaciones
# a todas las usuarias).
