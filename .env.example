VITE_SUPABASE_URL=your-supabase-url
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Analitica de producto (PostHog) — OPCIONAL.
# Sin esta key, la analitica queda apagada (no-op, cero llamadas de red).
# 1. Crea cuenta gratis en https://posthog.com (free: 1M eventos/mes).
# 2. Copia tu Project API Key (empieza con "phc_").
# 3. Pegala aqui y tambien en Vercel (Settings > Environment Variables).
VITE_POSTHOG_KEY=phc_tu_project_api_key
# Solo si tu proyecto es region EU (por defecto US):
# VITE_POSTHOG_HOST=https://eu.i.posthog.com

# ─────────────────────────────────────────────────────────────
# Variables del SERVIDOR (Vercel Functions en /api).
# NO llevan prefijo VITE_ (no se exponen al navegador). Se configuran
# en Vercel > Settings > Environment Variables, no en el bundle.
# ─────────────────────────────────────────────────────────────

# Anthropic — usada por /api/agent, /api/guia y /api/generate-program
# (la Guia IA, el chat "Tu Ronda" y la generacion de programas).
ANTHROPIC_API_KEY=sk-ant-...

# OneSignal — notificaciones push (/api/notify)
ONESIGNAL_APP_ID=tu-onesignal-app-id
ONESIGNAL_API_KEY=tu-onesignal-rest-api-key
